{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "liuhe-formula-poster",
  "main": "./worker/cache-proxy.js",
  "compatibility_date": "2026-09-03",
  "services": [
    {
      "binding": "APP",
      "service": "liuhe-formula-poster-backend"
    },
    {
      "binding": "RECOMMENDATIONS",
      "service": "123-liuhe-textdomains-api"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "HTML_CACHE",
      "id": "2c8a78b384e34253b341ce878f77a0d0"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VIEW_COUNTER",
        "class_name": "PostViewCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "view-counts-v1",
      "new_sqlite_classes": [
        "PostViewCounter"
      ]
    }
  ]
}
