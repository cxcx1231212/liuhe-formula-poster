{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "liuhe-formula-poster",
  "main": "./worker/edge-entry.js",
  "compatibility_date": "2026-09-03",
  "services": [
    {
      "binding": "APP",
      "service": "liuhe-formula-poster-backend"
    },
    {
      "binding": "RECOMMENDATIONS",
      "service": "123-liuhe-textdomains-api"
    }
  ],
  "d1_databases": [
    {
      "binding": "ADS_DB",
      "database_name": "123-liuhe-db",
      "database_id": "1bcdd595-e8a1-4a56-a76c-1d460c45f0f7"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "HTML_CACHE",
      "id": "2c8a78b384e34253b341ce878f77a0d0"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VIEW_COUNTER",
        "class_name": "PostViewCounter"
      },
      {
        "name": "ENTRY_SESSION",
        "class_name": "EntrySession"
      },
      {
        "name": "ENTRY_TICKET",
        "class_name": "EntryTicket"
      }
    ]
  },
  "migrations": [
    {
      "tag": "view-counts-v1",
      "new_sqlite_classes": [
        "PostViewCounter"
      ]
    },
    {
      "tag": "entry-gate-v1",
      "new_sqlite_classes": ["EntrySession", "EntryTicket"]
    }
  ]
}
